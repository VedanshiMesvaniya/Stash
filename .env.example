# Copy this file to .env and fill in the values below.
# Never commit the real .env file.

# REQUIRED — app will not start without this.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave blank for local development (uses a local SQLite file automatically).
# In production, set this to your Neon/Postgres connection string.
DATABASE_URL=

# LLM providers for the chat parser. The app works without these (chat
# messages just get queued and retried later), but you need at least one
# for the AI parsing to actually happen. Tried in order: Groq -> NVIDIA ->
# OpenRouter, first one that succeeds wins.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# development | production — production enables HTTPS-only session cookies,
# so only set this to "production" once you're actually serving over HTTPS.
ENVIRONMENT=development

# How often (seconds) the background job retries any chat messages that
# failed because both LLM providers were down. Default is fine for most.
PENDING_RETRY_INTERVAL_SECONDS=300

# Used in one outgoing LLM request header. Fine to leave as-is locally.
APP_PUBLIC_URL=https://stash.local

# Gmail SMTP - used to send the 6-digit verification code during
# self-registration (see app/services/email_service.py). SMTP_PASSWORD must
# be a Google App Password, NOT your normal Gmail password - that requires
# turning on 2-Step Verification first, then generating one at
# https://myaccount.google.com/apppasswords. Registration won't work
# locally until these are set - you'll get a clear error on the send-code
# step instead of a silent failure.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Stash
